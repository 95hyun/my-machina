{
  "enabledPlugins": {
    "claude-seo@agricidaniel-claude-seo": false
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "Edit(./hackathon/runs/**)",
      "Bash(./hackathon/bin/newrun:*)",
      "Bash(./hackathon/bin/mark:*)",
      "Bash(./hackathon/bin/ideas:*)",
      "Bash(./hackathon/bin/share:*)",
      "Bash(ls hackathon/runs/:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/git-guard.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/review-suggest.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
