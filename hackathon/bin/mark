#!/bin/sh
# 현재 run의 timing.log에 시각 기록 + 기획 시작부터 경과 분 출력. 사용: hackathon/bin/mark <단계> <start|end>
set -e
cd "$(dirname "$0")/../.."  # 워크스페이스 루트 — CURRENT는 루트 기준 경로
run=$(cat hackathon/runs/CURRENT)
echo "$(date '+%H:%M:%S') $1 $2" >> "$run/timing.log"
first=$(head -1 "$run/timing.log" | cut -d' ' -f1)
now=$(date '+%H:%M:%S')
to_s() { echo "$1" | awk -F: '{print $1*3600+$2*60+$3}'; }
el=$(( ($(to_s "$now") - $(to_s "$first") + 86400) % 86400 / 60 ))
echo "run=$run 경과=${el}분 (기획 하드캡 45분)"
