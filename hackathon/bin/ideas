#!/bin/sh
# 현재 run의 ideas-*.jsonl을 후보당 한 줄로 압축 출력(메인 opus 토큰 절약). 사용: hackathon/bin/ideas [id ...]
set -e
cd "$(dirname "$0")/../.."  # 워크스페이스 루트 — CURRENT는 루트 기준 경로
run=$(cat hackathon/runs/CURRENT)
python3 - "$run" "$@" <<'PY'
import glob, json, sys
run, want = sys.argv[1], set(sys.argv[2:])
cut = lambda s, n: (s or "").replace("\n", " ")[:n]
for f in sorted(glob.glob(f"{run}/ideas-*.jsonl")):
    for line in open(f):
        line = line.strip()
        if not line:
            continue
        try:
            d = json.loads(line)
        except ValueError:
            print(f"!! 파싱 실패 {f}: {line[:60]}")
            continue
        if want and d.get("id") not in want:
            continue
        if want:  # 지정 id는 원문 전체
            print(json.dumps(d, ensure_ascii=False))
        else:
            print(f'{d.get("id")} | {cut(d.get("title"),30)} | {d.get("country")}·{cut(d.get("persona"),20)} | {cut(d.get("problem"),50)} | 데모: {cut(d.get("demo"),45)} | 지불: {cut(d.get("payer"),25)}')
PY
