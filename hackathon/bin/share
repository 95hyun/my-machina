#!/bin/sh
# 현재 run 산출물을 share.md 하나로 합친다(내용 재작성 없음). 사용: hackathon/bin/share
set -e
cd "$(dirname "$0")/../.."  # 워크스페이스 루트 — CURRENT는 루트 기준 경로
run=$(cat hackathon/runs/CURRENT)
out="$run/share.md"
: > "$out"
for f in 01-topics.md 02-problems.md 02-scout-*.md 03-compare.md 03-final.md 03-onepager-*.md 03-redteam.md 04-mvp.md 04-review.md 05-pitch.md; do
  for p in "$run"/$f; do
    [ -f "$p" ] || continue
    printf -- '\n---\n# %s\n\n' "$(basename "$p")" >> "$out"
    cat "$p" >> "$out"
  done
done
echo "$(pwd)/$out ($(wc -c < "$out" | tr -d ' ') bytes)"
